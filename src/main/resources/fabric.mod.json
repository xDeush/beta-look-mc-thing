{
	"schemaVersion": 1,
	"id": "betalook",
	"version": "${version}",
	"name": "BetaLook",
	"description": "Sprawia, ze wspolczesny Minecraft wyglada jak Beta 1.7.3: tekstury, swiatlo, mgla i animacje z bety, a wszystko dodane po becie przestaje byc renderowane.",
	"authors": [
		"xDeush"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.betalook.BetaLook"
		],
		"client": [
			"com.betalook.client.BetaLookClient"
		]
	},
	"mixins": [
		{
			"config": "betalook.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "betalook.optional.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": ">=${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
